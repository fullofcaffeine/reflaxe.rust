# Use bd merge for beads JSONL files
.beads/issues.jsonl merge=beads text eol=lf
.beads/interactions.jsonl merge=beads text eol=lf

# Release policy, workflow, documentation, and package inputs compare bytes across platforms.
*.cjs text eol=lf
*.hxml text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# This is an exact upstream-to-vendor patch. Its added lines preserve upstream
# whitespace byte-for-byte, so the outer repository must not reinterpret them.
vendor/reflaxe/reflaxe-rust.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab
